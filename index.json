emplate/blob/main/docs/index.md","edit_url":"https://github.com/InsightSoftwareConsortium/InsightJournalTemplate/edit/main/docs/index.md","thumbnail":"/build/RegistrationComponen-8107cd05091676f7fcffa0b356dbd2cb.eps","exports":[{"format":"md","filename":"index.md","url":"/build/index-27ef5b23f99c8283f23367cabd83b87d.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Using filters from the Insight Toolkit, we develop an algorithm for detecting\nand tracking the movement of solar spots. As it is widely known, celestial\nobjects such as the sun are ethereal and perfect, and therefore can not harbor\nartifacts such as spots. However, observations performed with our open source\ntelescope have revealed the presence of such spots. The spots seems to continuously change positions on the solar surface.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"VItsj6kEBH"}],"key":"uj4xu1ZK1J"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Automatic detection and tracking of the solar spot movements are of fundamental\nimportance for allowing the authors to dedicate more time to perfectioning\noptical instruments and less time to the supervised acquisition of reliable\ndata.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"Ihz03TUJho"}],"key":"LuQRRrhueP"},{"type":"admonition","kind":"warning","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Warning","key":"fJiMZQkQzO"}],"key":"yz8SCUvqgK"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"The reader should be warned that direct observation of the sun without proper\nequipment may result in personal injury, loss of vision and burned brains.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"uiCAZRWNG3"}],"key":"QFSw2L9eZu"}],"key":"HzviLinnt6"},{"type":"heading","depth":2,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Principles of Solar Spot Detection","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"XV6MtEvqew"}],"identifier":"principles-of-solar-spot-detection","label":"Principles of Solar Spot Detection","html_id":"principles-of-solar-spot-detection","implicit":true,"key":"RoeNsuDi5O"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Solar spots can be classified as the darkest objects present on an image of the\nsolar surface. Algorithms such as watersheds, statistical classification and\nmathematical morphology are suitable for automatically detecting these features\nin images of the solar surface.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"iyKYukNClO"}],"key":"BdMDFNI71h"},{"type":"heading","depth":2,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Why Image Processing Papers must include Source Code, Images and Parameters","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"iKDSSs2xh8"}],"identifier":"why-image-processing-papers-must-include-source-code-images-and-parameters","label":"Why Image Processing Papers must include Source Code, Images and Parameters","html_id":"why-image-processing-papers-must-include-source-code-images-and-parameters","implicit":true,"key":"mWBe4FEwiY"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"Modern Image Processing is most of the time performed with computers. An\nattempt to replicate the results of an algorithm described in a paper entails\nto reimplement the algorithm into source code. This task is far from trivial\nand consumes months of work. The final result can not be guaranteed to be\nequivalent to the actual code that was used for testing the algorithm when the\npaper was written, and therefore it cannot be considered a baseline for\ncomparing the algorithm with other algorithms available to the reader.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"AyFQeqL7SY"}],"key":"ejd6SNjufM"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"Papers to the Insight Journal are written in the spirit of facilitating and\nencouraging readers to perform replication of work. In this sense, the Insight\nJournal is compliant with essential concepts of the scientific method.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"Ai9fDhJkoS"}],"key":"skOhF9uyVF"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"Since the code is included with the paper, less time has to be spent in\ndescribing the code, and more time can be used for describing how to use the\nalgorithm in particular types of images.","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"JoLzMBZ10L"}],"key":"SuWf7BHVWZ"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"For questions on the basis of the scientific method the reader is referred to\n","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"FbXNQPFemH"},{"type":"citeGroup","kind":"narrative","children":[{"type":"cite","kind":"narrative","label":"Popper2002","identifier":"popper2002","children":[{"type":"text","value":"Popper (2002)","key":"kLPamwUGdJ"}],"enumerator":"1","key":"Qae13zRdik"},{"type":"cite","kind":"narrative","label":"Popper1971","identifier":"pop